generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      String   @default("customer") // customer, admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses Address[]
  favorites Favorite[]
  adminLogs AdminLog[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  families Family[]

  @@map("categories")
}

model Family {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subfamilies Subfamily[]

  @@map("families")
}

model Subfamily {
  id          String   @id @default(uuid())
  familyId    String
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("subfamilies")
}

model Product {
  id                 String    @id @default(uuid())
  subfamilyId        String
  name               String
  slug               String    @unique
  code               String?
  shortDescription   String?
  description        String?
  normalPrice        Float
  webPrice           Float
  offerPrice         Float?
  discountPercentage Float?
  cost               Float     @default(0)
  status             String    @default("available")
  isFeatured         Boolean   @default(false)
  isNew              Boolean   @default(false)
  productionTime     String?
  displayOrder       Int       @default(0)
  labels             String? // JSON array
  images             String? // JSON array
  features           String? // JSON object
  isOffer            Boolean   @default(false)
  isActive           Boolean   @default(true)
  stock              Int       @default(0)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  subfamily  Subfamily   @relation(fields: [subfamilyId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  favorites  Favorite[]

  @@index([createdAt])
  @@index([deletedAt])
  @@index([subfamilyId])
  @@index([isActive])
  @@index([status])
  @@index([deletedAt, isActive])
  @@map("products")
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  name         String
  province     String
  city         String
  neighborhood String?
  street       String
  number       String
  floor        String?
  apartment    String?
  postalCode   String?
  references   String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("favorites")
}

model Promotion {
  id          String   @id @default(uuid())
  title       String
  description String?
  discount    Float // Porcentaje de descuento
  code        String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  isWeb       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("promotions")
}

model Flyer {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("flyers")
}

model Order {
  id              String    @id @default(uuid())
  userId          String
  status          String    @default("pending") // pending, payment_pending, paid, in_production, ready, shipped, delivered, cancelled
  deliveryMethod  String // pickup, local_delivery, interior_shipping
  subtotal        Float
  discount        Float     @default(0)
  total           Float
  shippingCost    Float     @default(0)
  customerName    String
  customerPhone   String
  customerEmail   String
  address         String?
  notes           String?
  paymentId       String? // ID de Mercado Pago
  paymentStatus   String? // pending, approved, rejected
  paymentMethod   String? // payment_type: credit_card, debit_card, etc.
  merchantOrderId String? // ID de merchant order de Mercado Pago
  dateApproved    DateTime? // Fecha de acreditación del pago
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float // Precio al momento de la compra
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model AdminLog {
  id          String   @id @default(uuid())
  adminId     String
  action      String // login, create_product, update_product, delete_product, change_price, change_promotion, etc.
  entityType  String? // product, category, promotion, flyer, order, etc.
  entityId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_logs")
}
