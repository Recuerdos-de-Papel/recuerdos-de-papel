# Base de datos Supabase (Pooler)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Variables requeridas para Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxx
MERCADO_PAGO_PUBLIC_KEY=TEST-xxx
MERCADO_PAGO_WEBHOOK_SECRET=your-webhook-secret

# CORS
CORS_ORIGIN=https://recuerdos-de-papel.onrender.com

# Server
NODE_ENV=production
PORT=10000
BACKEND_URL=https://recuerdos-de-papel-backend.onrender.com